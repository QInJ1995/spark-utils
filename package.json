{
  "name": "spark-utils",
  "version": "2.0.0",
  "description": "同构 JavaScript/TypeScript 工具库（Node 与浏览器通用）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js",
      "require": "./dist/crypto.cjs"
    },
    "./pinyin": {
      "types": "./dist/pinyin.d.ts",
      "import": "./dist/pinyin.js",
      "require": "./dist/pinyin.cjs"
    },
    "./umd": "./dist/spark-utils.min.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "npm run typecheck && rollup -c && rollup -c rollup.umd.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gen:fixtures": "vite-node scripts/gen-fixtures.mjs",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "docs:dev": "cd docs && vitepress dev",
    "docs:build": "cd docs && vitepress build",
    "docs:preview": "cd docs && vitepress preview",
    "size": "node scripts/check-size.mjs"
  },
  "keywords": [
    "spark-utils",
    "utils",
    "typescript",
    "isomorphic"
  ],
  "author": "QINJIN",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "dependency-cruiser": "^16.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.12.0",
    "jsdom": "^26.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite-node": "^6.0.0",
    "vitepress": "^1.1.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "jsrsasign": "^10.5.13"
  }
}
