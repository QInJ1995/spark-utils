{
  "module": "string",
  "method": "checkPass",
  "cases": [
    {
      "args": [
        "123456"
      ],
      "output": 1,
      "note": "6 位纯数字 → 等级 1"
    },
    {
      "args": [
        "12345678"
      ],
      "output": 0,
      "note": "仅 1 类字符 → 归零返回 0"
    },
    {
      "args": [
        "abcd1234"
      ],
      "output": 2,
      "note": "小写+数字 → 等级 2"
    },
    {
      "args": [
        "Abcd1234"
      ],
      "output": 3,
      "note": "大写+小写+数字 → 等级 3"
    },
    {
      "args": [
        "Abcd12#$"
      ],
      "output": 4,
      "note": "四类字符 → 等级 4（长度 8 也放行，注释写 10-18 但代码是 8-20）"
    },
    {
      "args": [
        "中文abc123"
      ],
      "output": 3,
      "note": "怪癖：中文拦截正则写错（含空格的 | 交替）不生效，且中文计入 \\W，返回 3"
    }
  ]
}
