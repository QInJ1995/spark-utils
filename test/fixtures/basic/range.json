{
  "module": "basic",
  "method": "range",
  "cases": [
    {
      "args": [
        5
      ],
      "output": [
        0,
        1,
        2,
        3,
        4
      ],
      "note": "单参即 stop，[0,1,2,3,4]"
    },
    {
      "args": [
        1,
        5
      ],
      "output": [
        1,
        2,
        3,
        4
      ],
      "note": "含头不含尾 [1,2,3,4]"
    },
    {
      "args": [
        0,
        10,
        3
      ],
      "output": [
        0,
        3,
        6,
        9
      ],
      "note": "步长 3 得 [0,3,6,9]"
    },
    {
      "args": [
        0
      ],
      "output": [],
      "note": "stop 为 0 得 []"
    },
    {
      "args": [
        5,
        1
      ],
      "output": [],
      "note": "start >= stop（实际与 stop 而非 len 比较）直接 []"
    },
    {
      "args": [
        3.7
      ],
      "output": [
        0,
        1,
        2
      ],
      "note": "怪癖：小数经 >>0 截断，得 [0,1,2]"
    }
  ]
}
