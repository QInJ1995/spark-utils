      "output": false,
      "note": "Invalid Date 的 getTime 为 NaN，false"
    },
    {
      "args": [
        "2024-03-05"
      ],
      "output": false,
      "note": "字符串直接不是 Date，false"
    },
    {
      "args": [
        null
      ],
      "output": false,
      "note": "false"
    }
  ]
