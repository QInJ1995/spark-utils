{
  "module": "date",
  "method": "isDateTime",
  "cases": [
    {
      "args": [
        "2024-03-05 08:30:00"
      ],
      "output": true,
      "note": "合法：日期 + 空格 + 时间，总长 19"
    },
    {
      "args": [
        "2024-13-05 08:30:00"
      ],
      "output": false,
      "note": "月份 13 溢出 false"
    },
    {
      "args": [
        "2024-02-30 08:30:00"
      ],
      "output": false,
      "note": "2 月 30 日溢出 false"
    },
    {
      "args": [
        "2024-03-05T08:30:00"
      ],
      "output": false,
      "note": "T 分隔不符合内部约定（无空格）false"
    },
    {
      "args": [
        12345
      ],
      "output": false,
      "note": "数字无 length（undefined !== 19），返回 false 不抛错"
    }
  ]
}
