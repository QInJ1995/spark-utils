{
  "module": "date",
  "method": "dateDiff",
  "cases": [
    {
      "args": [
        "2024-01-01",
        "2024-03-10",
        "d"
      ],
      "output": 69,
      "note": "字符串入参自动 StringToDate：69 天"
    },
    {
      "args": [
        "2024-01-01",
        "2024-03-10 12:00:00",
        "h"
      ],
      "output": 1668,
      "note": "混合日期时间串按小时"
    },
    {
      "args": [
        "2024-01-15",
        "2024-03-15",
        "M"
      ],
      "output": 2,
      "note": "月差（按 getMonth 差计算）"
    },
    {
      "args": [
        {
          "__type": "Date",
          "value": "2024-03-05T00:00:00.000Z"
        },
        {
          "__type": "Date",
          "value": "2024-03-05T00:01:30.000Z"
        },
        "n"
      ],
      "output": 1,
      "note": "Date 入参按分钟（parseInt 截断）"
    },
    {
      "args": [
        "2024-03-10",
        "2024-01-01",
        "d"
      ],
      "output": -69,
      "note": "结束早于开始：负数 -69"
    },
    {
      "args": [
        "abc",
        "2024-01-01",
        "d"
      ],
      "output": false,
      "note": "非法入参返回 false"
    }
  ]
}
