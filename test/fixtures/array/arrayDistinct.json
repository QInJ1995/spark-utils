    },
    {
      "args": [
        [
          {
            "__type": "Object",
            "value": {
              "id": 1,
              "v": "a"
            }
          },
          {
            "__type": "Object",
            "value": {
              "id": 2,
              "v": "b"
            }
          },
          {
            "__type": "Object",
            "value": {
              "id": 1,
              "v": "c"
            }
          }
        ],
        "id"
      ],
      "output": [
        {
          "__type": "Object",
          "value": {
            "id": 1,
            "v": "a"
          }
        },
        {
          "__type": "Object",
          "value": {
            "id": 2,
            "v": "b"
          }
        }
      ],
      "note": "对象数组按属性去重，保留首个"
    },
    {
      "args": [
        [
          1,
