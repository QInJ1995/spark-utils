{
  "module": "array",
  "method": "union",
  "cases": [
    {
      "args": [
        [
          1,
          2
        ],
        [
          2,
          3
        ],
        [
          3,
          4
        ]
      ],
      "output": [
        1,
        2,
        3,
        4
      ],
      "note": "多数组并集去重"
    },
    {
      "args": [
        [
          1,
          2
        ]
      ],
      "output": [
        1,
        2
      ],
      "note": "单数组等于 uniq"
    },
    {
      "args": [
        [],
        []
      ],
      "output": [],
      "note": "空数组们返回 []"
    },
    {
      "args": [
        "ab",
        [
          "b",
          "c"
        ]
      ],
      "output": [
        "a",
        "b",
        "c"
      ],
      "note": "字符串参数被 toArray 拆成字符（怪癖）"
    }
  ]
}
