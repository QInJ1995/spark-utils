      "output": -1,
      "note": "未命中返回 -1"
    },
    {
      "args": [
        {
          "__type": "Object",
          "value": {
            "a": 5,
            "b": 3,
            "c": 1
          }
        },
        {
          "__type": "Function",
          "src": "function (v) { return v < 4 }"
        }
      ],
