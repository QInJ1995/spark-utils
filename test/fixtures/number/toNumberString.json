{
  "module": "number",
  "method": "toNumberString",
  "cases": [
    {
      "args": [
        123.456
      ],
      "output": "123.456"
    },
    {
      "args": [
        1e+21
      ],
      "output": "1000000000000000000000",
      "note": "科学计数展开为 1 后跟 21 个 0 的整数字符串"
    },
    {
      "args": [
        1.2e-7
      ],
      "output": "0.00000012",
      "note": "负指数展开：0.00000012"
    },
    {
      "args": [
        -0.0000015
      ],
      "output": "-0.0000015",
      "note": "负数负指数展开：-0.0000015"
    },
    {
      "args": [
        "abc"
      ],
      "output": "abc",
      "note": "非数字字符串原样返回"
    }
  ]
}
