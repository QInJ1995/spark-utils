{
  "module": "number",
  "method": "moneyFormat",
  "cases": [
    {
      "args": [
        1234567.891,
        2
      ],
      "output": "1,234,567.89"
    },
    {
      "args": [
        1234567.891
      ],
      "output": "1,234,568",
      "note": "不传 decimal 按 0 位四舍五入：1,234,568"
    },
    {
      "args": [
        -9876.5,
        2
      ],
      "output": "-9,876.50",
      "note": "负数千分位"
    },
    {
      "args": [
        0
      ],
      "output": "",
      "note": "已知 BUG：!money 把 0 当非法返回空串（2.0 修正并登记 override）"
    },
    {
      "args": [
        "0"
      ],
      "output": "0",
      "note": "怪癖：字符串 0 不触发 !money，返回 \"0\""
    },
    {
      "args": [
        1234.5,
        2,
        "￥"
      ],
      "output": "￥1,234.50",
      "note": "带货币前缀"
    }
  ]
}
